        "defaults": {
          "color": {
            "mode": "fixedColor"
          },
          "decimals": 0,
          "mappings": [],
          "min": 0,
          "unit": "short"
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "passed"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "fixedColor": "green",
                  "mode": "fixedColor"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "certifying"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "fixedColor": "yellow",
                  "mode": "fixedColor"
